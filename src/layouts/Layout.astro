---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

import { PREVIEW } from 'astro:env/client';

import { SEO } from 'astro-seo';

const {
  title = 'dekolis.com',
  description = 'Dorian Kolis is an engineer studying at Dartmouth College with extensive experience in engineering, programming, and biology',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta charset="UTF-8" />

    <!--Import JetBrains Mono font-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
    />
    <!--Import Outfit font-->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap"
    />

    <title>{`${title} — Dorian Kolis`}</title>

    <!--TODO: enable indexing-->
    <SEO
      noindex={true}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: 'article',
          image: 'https://r2bucket.dekolis.com/Index/IMG_1366%20sq.jpg',
        },
        optional: {
          siteName: 'Dorian Kolis',
          description: description,
        },
      }}
      extend={{
        link: [
          { rel: 'sitemap', href: '/sitemap-index.xml' },
          { rel: 'icon', type: 'image/png', sizes: '32x32', href: '/favicon-32x32.png' },
          { rel: 'icon', type: 'image/png', sizes: '16x16', href: '/favicon-16x16.png' },
          { rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' },
          { rel: 'icon', type: 'image/png', sizes: '192x192', href: '/android-chrome-192x192.png' },
          { rel: 'icon', type: 'image/png', sizes: '512x512', href: '/android-chrome-512x512.png' },
          { rel: 'shortcut icon', href: '/favicon.ico' },
        ],
        meta: [{ name: 'theme-color', content: '#047857' }],
      }}
    />
  </head>
  <body>
    {
      PREVIEW && (
        <div class="preview-notice">
          This is a preview version of the site.{' '}
          <a href="https://dekolis.com">Click here to go the main site.</a>
        </div>
      )
    }
    <Navigation />
    <slot />
    <Footer />
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    font-family:
      'Outfit',
      system-ui,
      -apple-system,
      sans-serif;
    min-height: 100%;
    position: relative;
  }

  body {
    margin: 0 0 290px;
    padding: 0;
    min-height: 100vh;
  }

  .preview-notice {
    top: 0;
    left: 0;
    width: 100%;
    padding: 0.6rem 1rem;
    background: #8888d7;
    color: #00392a;
    font-size: 0.9rem;
    text-align: center;
    font-weight: bold;
    border-bottom: 1px solid #5a5aff;
    z-index: 999;
  }

  .preview-notice a {
    text-decoration: none;
  }

  .preview-notice a:hover {
    text-decoration: underline;
  }
</style>
