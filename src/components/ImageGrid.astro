---
interface ImageItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  layout: '2col' | '3col' | '4col' | 'masonry' | 'hero' | '1-2';
  images: ImageItem[];
}

const { layout, images } = Astro.props;
---

<div class:list={['image-grid', `grid-${layout}`]}>
  {
    images.map((img, i) => (
      <figure class="grid-image">
        <img
          src={img.src}
          alt={img.alt}
          data-caption={img.caption || undefined}
          loading={i < 2 ? 'eager' : 'lazy'}
        />
        {img.caption && <figcaption>{img.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .image-grid {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }

  .image-grid :global(img) {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }

  .image-grid :global(img:hover) {
    opacity: 0.9;
  }

  .image-grid :global(figcaption) {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .image-grid :global(figure) {
    margin: 0;
  }

  /* 2col */
  .grid-2col {
    grid-template-columns: repeat(2, 1fr);
  }

  /* 3col */
  .grid-3col {
    grid-template-columns: repeat(3, 1fr);
  }

  /* 4col */
  .grid-4col {
    grid-template-columns: repeat(4, 1fr);
  }

  /* masonry */
  .grid-masonry {
    columns: 3;
    column-gap: 0.5rem;
  }

  .grid-masonry :global(figure) {
    break-inside: avoid;
    margin-bottom: 0.5rem;
  }

  /* hero */
  .grid-hero {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto;
  }

  .grid-hero :global(figure:first-child) {
    grid-row: 1 / -1;
  }

  /* 1-2 */
  .grid-1-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-1-2 :global(figure:first-child) {
    grid-column: 1 / -1;
  }

  /* Mobile: collapse to single column */
  @media (max-width: 768px) {
    .image-grid {
      grid-template-columns: 1fr !important;
      columns: 1 !important;
    }
  }
</style>
